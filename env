# ─── Guesty API Credentials ───────────────────────────────────────────────────
# Get these from: Guesty Dashboard → Integrations → API → Open API Keys
GUESTY_CLIENT_ID=your_client_id_here
GUESTY_CLIENT_SECRET=your_client_secret_here

# ─── API Settings ─────────────────────────────────────────────────────────────
GUESTY_BASE_URL=https://open-api.guesty.com
GUESTY_TOKEN_URL=https://open-api.guesty.com/oauth2/token

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
